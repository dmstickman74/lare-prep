# Copy to .env on the VM and fill in. The compose file fails fast if any of
# these are unset, so you'll see a clear error rather than a silent misconfig.

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- App ---------------------------------------------------------------------
# Public URL — used to build the SSO callback URL Impexium redirects back to.
APP_URL=https://lareprep.aslalabs.org

# Default is "production". Set to "development" locally to enable /api/auth/dev-login.
NODE_ENV=production

# Per-app secret. Generate with: openssl rand -base64 36
# Never reuse across sites. Rotate by changing this and restarting — all
# existing sessions invalidate.
JWT_SECRET=

# --- Impexium (Live tenant) --------------------------------------------------
# Pull these from 1Password: "ASLA Impexium API Live" in the IT vault.
# (Or run: bash ~/.claude/skills/add-impexium-sso/scripts/read-creds.sh live)
IMPEXIUM_APP_NAME=
IMPEXIUM_APP_KEY=
IMPEXIUM_APP_ID=
IMPEXIUM_APP_PASSWORD=
IMPEXIUM_APP_USER_EMAIL=
IMPEXIUM_APP_USER_PASSWORD=
# The hosted login URL base (e.g. https://my.asla.org)
IMPEXIUM_CLIENT_URL=
