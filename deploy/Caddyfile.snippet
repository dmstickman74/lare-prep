# Drop this into your host Caddyfile. The host Caddy is on the
# portainer-proxy_proxy Docker network, which the lareprep stack joins as
# `proxy`, so it can resolve lareprep-api by container name.

lareprep.aslalabs.org {
    encode zstd gzip
    reverse_proxy lareprep-api:4001

    log {
        output file /var/log/caddy/lareprep.log
    }
}
